# Database (Postgres)
POSTGRES_IMAGE_VERSION=18.3
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=changethis # overridden in Github Workflow for production

# Backend database
POSTGRES_BACKEND_DB=app
POSTGRES_BACKEND_USER=backend
POSTGRES_BACKEND_PASSWORD=changethis # overridden in Github Workflow for production

# Keycloak database
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=changethis # overridden in Github Workflow for production

# Identity (Keycloak)
KEYCLOAK_IMAGE_VERSION=26.5
KEYCLOAK_START_COMMAND=start-dev # overridden to "start" in Github Workflow for production
#KEYCLOAK_HOSTNAME= # overridden in Github Workflow for production (e.g. https://auth.myapp.example.com)
#KEYCLOAK_PROXY_HEADERS= # overridden to "xforwarded" in Github Workflow for production
KEYCLOAK_REALM=drone-grid
KEYCLOAK_RDBMS=postgres
KEYCLOAK_JDBC_CONNECTION_URL=jdbc:postgresql://db:5432/keycloak
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=changethis # overridden in Github Workflow for production

# Streaming (MediaMTX)
MEDIAMTX_API_URL=http://streaming:9997 # overridden in Github Workflow for production
WEBRTC_BASE_URL=http://webrtc.localhost # overridden in Github Workflow for production (e.g. https://webrtc.drone-grid.com)

# Deployment
IS_PROD=false # overridden in Github Workflow for production
DOMAIN=localhost # overridden in Github Workflow for production
STACK_NAME=drone-grid
ACME_EMAIL=
