# Shared
ENVIRONMENT=local # overridden in Github Workflow for production (e.g. production)
DOMAIN=localhost # overridden in Github Workflow for production
STACK_NAME=drone-grid
ACME_EMAIL= # overridden in Github Workflow for production

# UI build args — baked into static assets at build time
VITE_API_URL=http://api.localhost # overridden by .env.prod in Github Workflow for production
VITE_KEYCLOAK_URL=http://auth.localhost # overridden by .env.prod in Github Workflow for production 
VITE_KEYCLOAK_REALM=drone-grid
VITE_KEYCLOAK_CLIENT_ID=drone-grid
VITE_WEBRTC_URL=http://webrtc.localhost ## overridden by .env.prod in Github Workflow for production
