# Shared
ENVIRONMENT=local # overridden in Github Workflow for production (e.g. production)
DOMAIN=localhost # overridden in Github Workflow for production
STACK_NAME=drone-grid
ACME_EMAIL= # overridden in Github Workflow for production

# RECOMMENDED: Substitute with your machine's mDNS hostname so other devices on your LAN (companion computers, other client machines) can
# access the services
DEV_HOST=localhost

API_URL=http://${DEV_HOST}:8000 # overridden by .env.prod in Github Workflow for production
KEYCLOAK_URL=http://${DEV_HOST}:8080 # overridden by .env.prod in Github Workflow for production
KEYCLOAK_REALM=drone-grid
KEYCLOAK_CLIENT_ID=drone-grid
WEBRTC_URL=http://${DEV_HOST}:8889 ## overridden by .env.prod in Github Workflow for production
# Traefik-only alternative (works on this machine only but endpoints are NOT accessible from other devices on the same LAN):
# API_URL=http://api.localhost
# KEYCLOAK_URL=http://auth.localhost
# WEBRTC_URL=http://webrtc.localhost

# ICE candidate must be explicitly specified.
WEBRTC_ADDITIONAL_HOSTS=${DEV_HOST}
