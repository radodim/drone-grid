# Database
POSTGRES_USER=backend
POSTGRES_PASSWORD=changethis # placeholder; overridden in Github Workflow for production. Lets Settings() instantiate for offline openapi/client generation.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=app

# Identity — KEYCLOAK_URL (public, pins the expected `iss`) and KEYCLOAK_REALM
# come from the root .env, shared with the UI build and Keycloak's KC_HOSTNAME
KEYCLOAK_INTERNAL_URL=http://identity:8080
KEYCLOAK_AUDIENCE=drone-grid

# Streaming
MEDIAMTX_API_URL=http://streaming:9997
WEBRTC_BASE_URL=http://webrtc.localhost # overridden in Github Workflow for production (e.g. https://webrtc.drone-grid.com)

# CORS
CORS_ORIGINS=http://localhost # overridden in Github Workflow for production (e.g. https://drone-grid.com)

# Messaging (NATS)
NATS_URL=nats://messaging:4222
