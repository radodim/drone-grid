# The stock mediamtx camera image plus one prebuilt WHIP-capable ffmpeg.
# The image's apt ffmpeg predates the WHIP muxer
FROM debian:trixie-slim AS ffmpeg
ADD --checksum=sha256:0c8716a94ac1fe22eb56e7a0cedd0f00c1d8fae712ec19973d679a7a87916743 \
    https://github.com/BtbN/FFmpeg-Builds/releases/download/autobuild-2026-07-31-14-10/ffmpeg-n8.1.2-34-g9b6c8969e0-linuxarm64-lgpl-8.1.tar.xz \
    /tmp/ffmpeg.tar.xz
RUN apt-get update \
    && apt-get install -y --no-install-recommends xz-utils \
    && mkdir /out \
    && tar -xf /tmp/ffmpeg.tar.xz -C /tmp \
    && cp /tmp/ffmpeg-n*/bin/ffmpeg /out/ffmpeg

FROM bluenviron/mediamtx:1.18.1-ffmpeg-rpi
COPY --from=ffmpeg /out/ffmpeg /usr/local/bin/ffmpeg-whip
RUN echo "Ensuring correct mDNS resolution by installing libnss-mdns..." \
    && apt-get update \
    && apt-get install -y --no-install-recommends libnss-mdns \
    && rm -rf /var/lib/apt/lists/*
