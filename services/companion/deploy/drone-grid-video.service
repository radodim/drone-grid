[Unit]
Description=Drone Grid video (mediamtx rpiCamera + WHIP publisher)
Documentation=https://github.com/radodim/drone-grid
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/drone-grid/companion.env
# Sweep an orphaned container after a hard power cut.
ExecStartPre=-/usr/bin/docker rm -f drone-grid-video
# Foreground run: logs land in journald; systemd is the single supervisor
# (no Docker restart policy on purpose).
ExecStart=/usr/bin/docker run --rm --name drone-grid-video \
  --network=host \
  --privileged \
  --tmpfs /dev/shm:exec \
  -v /run/udev:/run/udev:ro \
  -v /run/avahi-daemon:/run/avahi-daemon:ro \
  -v /etc/drone-grid/mediamtx.yml:/mediamtx.yml:ro \
  -e DRONE_ID -e DRONE_SECRET -e WHIP_URL \
  drone-grid-video:1.18.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
