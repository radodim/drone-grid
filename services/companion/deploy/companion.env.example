# Drone Grid companion configuration.
# Populate the values. The env file will be copied to /etc/drone-grid/companion.env by the install script.

DRONE_ID=
DRONE_SECRET=

CONTROL__CONNECTION_URL=udpin://0.0.0.0:14540
CONTROL__MESSAGING_URL=wss://api.drone-grid.com/api/v1/companion

# WHIP publish target for the video service (drone-grid-video unit).
# LAN dev stack: http://<dev-box>.local:8889 — the mDNS name just works
# (nss-mdns in the image + the host's avahi socket); an IP works too.
WHIP_URL=https://webrtc.drone-grid.com

# Video runs in the drone-grid-video container (camera config in
# /etc/drone-grid/mediamtx.yml), NOT in the companion. Do not enable both —
# the camera is single-user. Rollback to the legacy companion RTSPS pipeline:
# stop drone-grid-video, then uncomment:
# VIDEO__SOURCE__TYPE=rpicam
# VIDEO__MEDIA_SERVER_URL=media.drone-grid.com:443
# VIDEO__SECURE=true
# Optional camera params to override
# VIDEO__SOURCE__WIDTH=1280
# VIDEO__SOURCE__HEIGHT=720
# VIDEO__SOURCE__BITRATE=5m
# VIDEO__SOURCE__VFLIP=true
# VIDEO__SOURCE__HFLIP=true
